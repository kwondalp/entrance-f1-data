{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwondalp.github.io/entrance-f1-data/schemas/results-archive-season.v1.schema.json",
  "title": "ENTRANCE Results Archive v1 season",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apiVersion",
    "season",
    "archiveAsOfDate",
    "raceCount",
    "classificationRowCount",
    "races"
  ],
  "properties": {
    "schemaVersion": {
      "const": "results-archive-season.v1"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "season": {
      "type": "integer",
      "minimum": 1950
    },
    "archiveAsOfDate": {
      "type": "string",
      "format": "date"
    },
    "raceCount": {
      "type": "integer",
      "minimum": 1
    },
    "classificationRowCount": {
      "type": "integer",
      "minimum": 1
    },
    "races": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/race"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "position": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^(?:[1-9][0-9]*|[A-Z][A-Z0-9 ./_-]*)$"
        }
      ]
    },
    "classificationRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowId",
        "position",
        "driver",
        "constructor",
        "laps",
        "timeOrRetired",
        "points",
        "sharedDrive",
        "sharedDriveGroupId",
        "deadHeat",
        "deadHeatGroupId"
      ],
      "properties": {
        "rowId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "driver": {
          "$ref": "#/$defs/identity"
        },
        "constructor": {
          "$ref": "#/$defs/identity"
        },
        "laps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "timeOrRetired": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "points": {
          "type": "number",
          "minimum": 0
        },
        "sharedDrive": {
          "type": "boolean"
        },
        "sharedDriveGroupId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "deadHeat": {
          "type": "boolean"
        },
        "deadHeatGroupId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "round",
        "grandPrixName",
        "date",
        "winner",
        "classification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{4}-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "grandPrixName": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "winner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "drivers",
            "constructors",
            "laps",
            "time",
            "sharedDrive",
            "deadHeat"
          ],
          "properties": {
            "drivers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/identity"
              }
            },
            "constructors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/identity"
              }
            },
            "laps": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "time": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "sharedDrive": {
              "type": "boolean"
            },
            "deadHeat": {
              "type": "boolean"
            }
          }
        },
        "classification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/classificationRow"
          }
        }
      }
    }
  }
}
