{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.entrancesports.com/schemas/results-archive-manifest.v2.schema.json",
  "title": "ENTRANCE Results Archive production manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apiVersion",
    "releaseChannel",
    "dataStatus",
    "generatedFrom",
    "archiveAsOfDate",
    "coverage",
    "latestIncludedCutoff",
    "stableV1Preservation",
    "officialSourceIndex",
    "seasons"
  ],
  "properties": {
    "schemaVersion": {
      "const": "results-archive-manifest.v2"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^2\\.[0-9]+\\.[0-9]+$"
    },
    "releaseChannel": {
      "const": "production"
    },
    "dataStatus": {
      "const": "verified"
    },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerId",
        "producerVersion",
        "producerSourceChecksumSha256",
        "inputSetChecksumSha256",
        "generatedAtUtc"
      ],
      "properties": {
        "producerId": {
          "type": "string",
          "minLength": 1
        },
        "producerVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "producerSourceChecksumSha256": {
          "$ref": "#/$defs/sha256"
        },
        "inputSetChecksumSha256": {
          "$ref": "#/$defs/sha256"
        },
        "generatedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "archiveAsOfDate": {
      "$ref": "#/$defs/isoDate"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oldestIncludedSeason",
        "latestIncludedSeason",
        "includedSeasonCount",
        "includedRaceCount",
        "includedClassificationRowCount",
        "verifiedSeasonCount",
        "provisionalSeasonCount",
        "historicalStandingsStatus"
      ],
      "properties": {
        "oldestIncludedSeason": {
          "type": "integer",
          "minimum": 1950
        },
        "latestIncludedSeason": {
          "type": "integer",
          "minimum": 1950
        },
        "includedSeasonCount": {
          "type": "integer",
          "minimum": 1
        },
        "includedRaceCount": {
          "type": "integer",
          "minimum": 1
        },
        "includedClassificationRowCount": {
          "type": "integer",
          "minimum": 1
        },
        "verifiedSeasonCount": {
          "type": "integer",
          "minimum": 0
        },
        "provisionalSeasonCount": {
          "type": "integer",
          "minimum": 0
        },
        "historicalStandingsStatus": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "latestIncludedCutoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "round",
        "raceId",
        "raceSlug",
        "date"
      ],
      "properties": {
        "season": {
          "type": "integer",
          "minimum": 1950
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "raceId": {
          "type": "string",
          "minLength": 1
        },
        "raceSlug": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/isoDate"
        }
      }
    },
    "stableV1Preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestPath",
        "manifestSha256",
        "seasonPath",
        "seasonSha256"
      ],
      "properties": {
        "manifestPath": {
          "const": "../v1/manifest.json"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "seasonPath": {
          "const": "../v1/seasons/2026.json"
        },
        "seasonSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "officialSourceIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "recordCount",
        "byteSize",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "sources.json"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 1
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "seasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season",
          "path",
          "dataStatus",
          "raceCount",
          "classificationRowCount",
          "byteSize",
          "sha256"
        ],
        "properties": {
          "season": {
            "type": "integer",
            "minimum": 1950
          },
          "path": {
            "type": "string",
            "pattern": "^seasons/[0-9]{4}\\.json$"
          },
          "dataStatus": {
            "enum": [
              "verified",
              "provisional"
            ]
          },
          "raceCount": {
            "type": "integer",
            "minimum": 1
          },
          "classificationRowCount": {
            "type": "integer",
            "minimum": 1
          },
          "byteSize": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
