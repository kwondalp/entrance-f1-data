{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwondalp.github.io/entrance-f1-data/schemas/results-archive-beta-season.v1.schema.json",
  "title": "ENTRANCE Results Archive Beta v1 season",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apiVersion",
    "releaseChannel",
    "season",
    "dataStatus",
    "archiveAsOfDate",
    "sourceCoverage",
    "coverage",
    "unsupportedFields",
    "championship",
    "standings",
    "races"
  ],
  "properties": {
    "schemaVersion": {
      "const": "results-archive-beta-season.v1"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "releaseChannel": {
      "const": "beta"
    },
    "season": {
      "type": "integer",
      "minimum": 1950,
      "maximum": 2026
    },
    "dataStatus": {
      "enum": [
        "verified",
        "provisional"
      ]
    },
    "archiveAsOfDate": {
      "type": "string",
      "format": "date"
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpointType",
        "sourceChecksumSha256",
        "statusExplanation"
      ],
      "properties": {
        "checkpointType": {
          "type": "string",
          "minLength": 1
        },
        "sourceChecksumSha256": {
          "$ref": "#/$defs/sha256"
        },
        "statusExplanation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raceCount",
        "classificationRowCount",
        "verifiedRaceCount",
        "provisionalRaceCount"
      ],
      "properties": {
        "raceCount": {
          "type": "integer",
          "minimum": 1
        },
        "classificationRowCount": {
          "type": "integer",
          "minimum": 1
        },
        "verifiedRaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "provisionalRaceCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unsupportedFields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldReason"
      }
    },
    "championship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataStatus",
        "drivers",
        "constructors"
      ],
      "properties": {
        "dataStatus": {
          "enum": [
            "provisional",
            "unsupported"
          ]
        },
        "drivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "constructors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          }
        }
      }
    },
    "standings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drivers",
        "constructors"
      ],
      "properties": {
        "drivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standing"
          }
        },
        "constructors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standing"
          }
        }
      }
    },
    "races": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/race"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "aliases"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "fieldReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "reasonCode",
        "reason"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "standing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "entity",
        "points",
        "wins",
        "dataStatus"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "entity": {
          "$ref": "#/$defs/identity"
        },
        "points": {
          "type": "number"
        },
        "wins": {
          "type": "integer",
          "minimum": 0
        },
        "dataStatus": {
          "const": "provisional"
        }
      }
    },
    "position": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rowId",
        "classificationOrder",
        "position",
        "driver",
        "constructor",
        "entrant",
        "carNumber",
        "gridPosition",
        "officialPole",
        "fastestLap",
        "entered",
        "started",
        "finished",
        "classified",
        "laps",
        "timeOrRetired",
        "points",
        "sharedDrive",
        "sharedDriveGroupId",
        "deadHeat",
        "deadHeatGroupId",
        "creditedWin",
        "creditedPodium",
        "dataStatus"
      ],
      "properties": {
        "rowId": {
          "type": "string",
          "minLength": 1
        },
        "classificationOrder": {
          "type": "integer",
          "minimum": 1
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "driver": {
          "$ref": "#/$defs/identity"
        },
        "constructor": {
          "$ref": "#/$defs/identity"
        },
        "entrant": {
          "type": "null"
        },
        "carNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "gridPosition": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "officialPole": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "fastestLap": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "entered": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "started": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "finished": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "classified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "laps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "timeOrRetired": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "points": {
          "type": "number"
        },
        "sharedDrive": {
          "type": "boolean"
        },
        "sharedDriveGroupId": {
          "type": [
            "string",
            "null"
          ]
        },
        "deadHeat": {
          "type": "boolean"
        },
        "deadHeatGroupId": {
          "type": [
            "string",
            "null"
          ]
        },
        "creditedWin": {
          "type": "boolean"
        },
        "creditedPodium": {
          "type": "boolean"
        },
        "dataStatus": {
          "enum": [
            "verified",
            "provisional"
          ]
        }
      }
    },
    "winner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "drivers",
        "constructors",
        "laps",
        "time",
        "sharedDrive",
        "deadHeat"
      ],
      "properties": {
        "drivers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "constructors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "laps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "time": {
          "type": [
            "string",
            "null"
          ]
        },
        "sharedDrive": {
          "type": "boolean"
        },
        "deadHeat": {
          "type": "boolean"
        }
      }
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "round",
        "grandPrixName",
        "date",
        "circuitId",
        "dataStatus",
        "winner",
        "classification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "grandPrixName": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "circuitId": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataStatus": {
          "enum": [
            "verified",
            "provisional"
          ]
        },
        "winner": {
          "$ref": "#/$defs/winner"
        },
        "classification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/classification"
          }
        }
      }
    }
  }
}
