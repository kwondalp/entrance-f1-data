{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwondalp.github.io/entrance-f1-data/schemas/results-archive-manifest.v1.schema.json",
  "title": "ENTRANCE Results Archive v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apiVersion",
    "generatedFrom",
    "archiveAsOfDate",
    "oldestAvailableSeason",
    "latestAvailableSeason",
    "currentSeason",
    "counts",
    "seasons",
    "applicationState"
  ],
  "properties": {
    "schemaVersion": {
      "const": "results-archive-manifest.v1"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerId",
        "producerVersion",
        "producerSourceChecksumSha256",
        "inputSetChecksumSha256",
        "generationInputTimestamp"
      ],
      "properties": {
        "producerId": {
          "const": "entrance-f1-data-tools/results-archive-v1"
        },
        "producerVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        },
        "producerSourceChecksumSha256": {
          "$ref": "#/$defs/sha256"
        },
        "inputSetChecksumSha256": {
          "$ref": "#/$defs/sha256"
        },
        "generationInputTimestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "archiveAsOfDate": {
      "type": "string",
      "format": "date"
    },
    "oldestAvailableSeason": {
      "type": "integer",
      "minimum": 1950
    },
    "latestAvailableSeason": {
      "type": "integer",
      "minimum": 1950
    },
    "currentSeason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "publishedThroughRound",
        "publishedThroughRaceId",
        "publishedThroughDate"
      ],
      "properties": {
        "season": {
          "type": "integer",
          "minimum": 1950
        },
        "publishedThroughRound": {
          "type": "integer",
          "minimum": 1
        },
        "publishedThroughRaceId": {
          "$ref": "#/$defs/slug"
        },
        "publishedThroughDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seasonCount",
        "raceCount",
        "classificationRowCount"
      ],
      "properties": {
        "seasonCount": {
          "type": "integer",
          "minimum": 1
        },
        "raceCount": {
          "type": "integer",
          "minimum": 1
        },
        "classificationRowCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "seasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season",
          "path",
          "raceCount",
          "classificationRowCount",
          "byteSize",
          "sha256"
        ],
        "properties": {
          "season": {
            "type": "integer",
            "minimum": 1950
          },
          "path": {
            "type": "string",
            "pattern": "^seasons/[0-9]{4}\\.json$"
          },
          "raceCount": {
            "type": "integer",
            "minimum": 1
          },
          "classificationRowCount": {
            "type": "integer",
            "minimum": 1
          },
          "byteSize": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "applicationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateAuditPassed",
        "localApplicationApproved",
        "localApplicationState",
        "commitState",
        "remoteState",
        "publicationState",
        "deploymentState"
      ],
      "properties": {
        "candidateAuditPassed": {
          "const": true
        },
        "localApplicationApproved": {
          "const": true
        },
        "localApplicationState": {
          "enum": [
            "applied_to_working_tree"
          ]
        },
        "commitState": {
          "enum": [
            "not_committed"
          ]
        },
        "remoteState": {
          "enum": [
            "not_pushed"
          ]
        },
        "publicationState": {
          "enum": [
            "not_published"
          ]
        },
        "deploymentState": {
          "enum": [
            "not_deployed"
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
