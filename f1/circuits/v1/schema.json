{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kwondalp.github.io/entrance-f1-data/f1/circuits/v1/schema.json",
  "title": "ENTRANCE circuit facts v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "dataStatus",
    "season",
    "asOf",
    "asOfRaceDate",
    "circuits",
    "sources",
    "verification",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": "entrance-circuits.v1"
    },
    "dataStatus": {
      "const": "verified"
    },
    "season": {
      "const": 2026
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "asOfRaceDate": {
      "type": "string",
      "format": "date"
    },
    "circuits": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {
        "$ref": "#/$defs/circuit"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "retrievedAt",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "time",
        "milliseconds",
        "driverName",
        "holder",
        "year",
        "session",
        "sourceIds"
      ],
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^[0-9]{1,2}:[0-5][0-9]\\.[0-9]{3}$"
        },
        "milliseconds": {
          "type": "integer",
          "minimum": 1
        },
        "driverName": {
          "type": "string",
          "minLength": 1
        },
        "holder": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer",
          "minimum": 1950,
          "maximum": 2026
        },
        "session": {
          "enum": [
            "practice/1",
            "practice/2",
            "practice/3",
            "qualifying",
            "sprint-qualifying",
            "sprint-shootout",
            "sprint",
            "race"
          ]
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "circuit": {
      "type": "object",
      "required": [
        "raceId",
        "circuitId",
        "name",
        "lengthKm",
        "firstGrandPrix",
        "laps",
        "raceDistanceKm",
        "trackRecord",
        "lapRecord",
        "recordStatus",
        "recordReason",
        "fieldSourceIds"
      ],
      "properties": {
        "raceId": {
          "type": "string",
          "minLength": 1
        },
        "circuitId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lengthKm": {
          "type": "number",
          "exclusiveMinimum": 1,
          "exclusiveMaximum": 10
        },
        "firstGrandPrix": {
          "type": "integer",
          "minimum": 1950,
          "maximum": 2026
        },
        "laps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "raceDistanceKm": {
          "type": "number",
          "minimum": 100,
          "maximum": 400
        },
        "trackRecord": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/record"
            }
          ]
        },
        "lapRecord": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/record"
                },
                {
                  "properties": {
                    "session": {
                      "const": "race"
                    }
                  }
                }
              ]
            }
          ]
        },
        "recordStatus": {
          "enum": [
            "verified",
            "not_yet_established"
          ]
        },
        "recordReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "fieldSourceIds": {
          "type": "object",
          "required": [
            "lengthKm",
            "firstGrandPrix",
            "laps",
            "raceDistanceKm",
            "trackRecord",
            "lapRecord"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recordStatus": {
                "const": "not_yet_established"
              }
            }
          },
          "then": {
            "properties": {
              "raceId": {
                "const": "spain"
              },
              "trackRecord": {
                "type": "null"
              },
              "lapRecord": {
                "type": "null"
              },
              "recordReason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "trackRecord": {
                "$ref": "#/$defs/record"
              },
              "lapRecord": {
                "$ref": "#/$defs/record"
              }
            }
          }
        }
      ]
    }
  }
}
