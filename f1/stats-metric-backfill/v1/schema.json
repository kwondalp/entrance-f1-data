{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entrancesports.com/schemas/stats-metric-backfill.v1.schema.json",
  "title": "ENTRANCE Stats metric backfill v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "apiVersion",
    "releaseChannel",
    "dataStatus",
    "asOfRaceDate",
    "counts",
    "metrics"
  ],
  "properties": {
    "schemaVersion": { "const": "stats-metric-backfill.v1" },
    "apiVersion": { "const": "1.0.0" },
    "releaseChannel": { "enum": ["proposal", "production"] },
    "dataStatus": { "const": "evidence_scoped" },
    "asOfRaceDate": { "type": "string", "format": "date" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "available", "partial", "completeThroughCutoff", "blocked", "permissionRequired", "unavailable", "drivers", "constructors"],
      "properties": {
        "total": { "const": 144 },
        "available": { "type": "integer", "minimum": 1, "maximum": 144 },
        "partial": { "type": "integer", "minimum": 0, "maximum": 144 },
        "completeThroughCutoff": { "type": "integer", "minimum": 0, "maximum": 144 },
        "blocked": { "type": "integer", "minimum": 0, "maximum": 143 },
        "permissionRequired": { "type": "integer", "minimum": 0, "maximum": 144 },
        "unavailable": { "type": "integer", "minimum": 0, "maximum": 144 },
        "drivers": { "const": 76 },
        "constructors": { "const": 68 }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 144,
      "maxItems": 144,
      "items": { "$ref": "#/$defs/metric" }
    }
  },
  "$defs": {
    "number": { "type": "number" },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventIndex", "season", "round", "date", "grandPrixName", "circuitId"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "eventIndex": { "type": "integer", "minimum": 0 },
        "season": { "type": "integer", "minimum": 1950 },
        "round": { "type": "integer", "minimum": 1 },
        "date": { "type": "string", "format": "date" },
        "grandPrixName": { "type": "string", "minLength": 1 },
        "circuitId": { "type": "string", "minLength": 1 }
      }
    },
    "row": {
      "type": "object",
      "required": ["rank", "entityId", "entityName", "value"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "entityId": { "type": "string", "minLength": 1 },
        "entityName": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/number" },
        "event": { "$ref": "#/$defs/event" },
        "valueEvent": { "$ref": "#/$defs/event" },
        "firstEvent": { "$ref": "#/$defs/event" },
        "lastEvent": { "$ref": "#/$defs/event" },
        "boundary": { "$ref": "#/$defs/event" },
        "season": { "type": "integer", "minimum": 1950 },
        "seasons": { "type": "array", "items": { "type": "integer", "minimum": 1950 }, "uniqueItems": true },
        "firstSeason": { "type": "integer", "minimum": 1950 },
        "lastSeason": { "type": "integer", "minimum": 1950 },
        "groupId": { "type": "string" },
        "groupLabel": { "type": "string" },
        "numerator": { "$ref": "#/$defs/number" },
        "denominator": { "type": "integer", "minimum": 1 },
        "unknownStartCount": { "type": "integer", "minimum": 0 },
        "unknownGridCount": { "type": "integer", "minimum": 0 },
        "evidenceRowCount": { "type": "integer", "minimum": 0 },
        "grid": { "type": "integer", "minimum": 0 },
        "finish": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryMetricId",
        "entity",
        "statisticId",
        "metricId",
        "categoryId",
        "label",
        "route",
        "presentation",
        "definition",
        "scope",
        "cutoff",
        "evidenceClass",
        "status",
        "completeness",
        "blockingReason",
        "rowCount",
        "rows"
      ],
      "properties": {
        "registryMetricId": { "type": "string", "pattern": "^(drivers|constructors):" },
        "entity": { "enum": ["drivers", "constructors"] },
        "statisticId": { "type": "string", "minLength": 1 },
        "metricId": { "type": "string", "minLength": 1 },
        "categoryId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "route": { "type": "string", "pattern": "^/f1/stats/statistic/" },
        "presentation": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "cutoff": { "type": "string", "format": "date" },
        "evidenceClass": { "enum": ["A", "B", "C"] },
        "status": { "enum": ["partial", "complete_through_cutoff", "blocked"] },
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["current", "target"],
          "properties": {
            "current": { "type": "object" },
            "target": { "type": "object" }
          }
        },
        "blockingReason": { "type": ["string", "null"] },
        "dataPath": { "type": ["string", "null"] },
        "rowCount": { "type": "integer", "minimum": 0 },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "blocked" } } },
          "then": {
            "properties": {
              "blockingReason": { "type": "string", "minLength": 1 },
              "rowCount": { "const": 0 },
              "rows": { "maxItems": 0 }
            }
          },
          "else": { "properties": { "blockingReason": { "type": "null" } } }
        }
      ]
    }
  }
}
