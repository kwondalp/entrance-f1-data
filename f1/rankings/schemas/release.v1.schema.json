{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entrance-ranking-release.v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "season",
    "cutoff",
    "effectiveEvent",
    "generatedAtUtc",
    "releaseId",
    "idempotencyKey",
    "producerSha256",
    "methodologyVersion",
    "modelVersion",
    "configurationVersion",
    "referenceVersion",
    "populationHash",
    "dataStatus",
    "sourceVerification",
    "modelValidation",
    "publicationStatus",
    "approval",
    "inputs",
    "lineage",
    "rows",
    "score"
  ],
  "properties": {
    "schemaVersion": {
      "const": "entrance-ranking-release.v1"
    },
    "kind": {
      "enum": [
        "value",
        "power"
      ]
    },
    "season": {
      "type": "integer",
      "minimum": 1950
    },
    "cutoff": {
      "type": "string",
      "format": "date"
    },
    "publicationStatus": {
      "enum": [
        "candidate",
        "approved"
      ]
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "lineage": {
      "type": "object",
      "required": [
        "previousReleaseId",
        "revisionKind",
        "comparable"
      ],
      "properties": {
        "previousReleaseId": {
          "type": [
            "string",
            "null"
          ]
        },
        "revisionKind": {
          "enum": [
            "initial",
            "evidence_advance",
            "correction",
            "methodology_change"
          ]
        },
        "comparable": {
          "type": "boolean"
        }
      }
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "methodologyVersion": {
      "type": "string",
      "minLength": 1
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "referenceVersion": {
      "type": "string",
      "minLength": 1
    },
    "producerSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "populationHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "byteSize"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "canonicalId",
          "name",
          "status",
          "rank",
          "releaseId",
          "modelVersion",
          "cutoff"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "canonicalId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "status": {
            "enum": [
              "ranked",
              "withheld",
              "unavailable",
              "no-points",
              "salary-range",
              "missing",
              "compensation-unresolved",
              "season-mismatch",
              "conflicting",
              "incomparable"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "ranked"
                }
              }
            },
            "then": {
              "properties": {
                "rank": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "else": {
              "properties": {
                "rank": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "dataStatus": {
      "enum": [
        "candidate",
        "verified"
      ]
    },
    "approval": {
      "type": "object"
    },
    "effectiveEvent": {
      "type": "object"
    },
    "score": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "value"
          }
        }
      },
      "then": {
        "required": [
          "salaries",
          "calculationVersion"
        ],
        "properties": {
          "rows": {
            "items": {
              "required": [
                "points",
                "salary",
                "salaryAmount",
                "cost",
                "reciprocal"
              ],
              "properties": {
                "points": {
                  "type": "number",
                  "minimum": 0
                },
                "cost": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "reciprocal": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "view",
          "readiness",
          "events",
          "evaluation",
          "decompositions"
        ],
        "properties": {
          "view": {
            "const": "pace"
          },
          "readiness": {
            "const": "pace-beta"
          },
          "rows": {
            "items": {
              "required": [
                "rating",
                "coverage",
                "uncertainty",
                "history",
                "entityType"
              ],
              "properties": {
                "entityType": {
                  "const": "driver-car"
                },
                "rating": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "coverage": {
                  "type": "object",
                  "required": [
                    "observed",
                    "eligible",
                    "unit"
                  ],
                  "properties": {
                    "observed": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "eligible": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "unit": {
                      "const": "GPs"
                    }
                  }
                },
                "history": {
                  "type": "array"
                }
              }
            }
          }
        }
      }
    }
  ]
}
