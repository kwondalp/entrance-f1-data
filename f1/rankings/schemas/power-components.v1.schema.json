{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entrance-power-components-research.v1",
  "type": "object",
  "required": ["schemaVersion", "modelVersion", "configurationVersion", "season", "cutoff", "unit", "direction", "publicationStatus", "sourceVerification", "modelValidation", "identifiability", "parameters", "reference", "trainedModel", "evaluation", "rows"],
  "properties": {
    "schemaVersion": {"const": "entrance-power-components-research.v1"},
    "modelVersion": {"const": "gp-weighted-driver-car-season-ridge-v1"},
    "configurationVersion": {"type": "string", "minLength": 1},
    "sourceVerification": {"const": "verified_input_bytes_and_archive_bindings"},
    "parameters": {
      "type": "object", "required": ["ridge", "ratio"], "additionalProperties": false,
      "properties": {"ridge": {"type": "number", "exclusiveMinimum": 0}, "ratio": {"type": "number", "exclusiveMinimum": 0}}
    },
    "reference": {
      "type": "object", "required": ["driverIds", "constructorIds", "weights", "season"],
      "properties": {
        "driverIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "constructorIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "weights": {"const": "equal-within-component"}, "season": {"type": "integer"}
      }
    },
    "trainedModel": {
      "type": "object", "required": ["path", "sha256", "byteSize", "distribution"],
      "properties": {
        "path": {"type": "string", "pattern": "^trained-models/model\\.[a-f0-9]{64}\\.json$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byteSize": {"type": "integer", "minimum": 1},
        "distribution": {"const": "retained_research_artifact"}
      }
    },
    "season": {"type": "integer", "minimum": 2022},
    "cutoff": {"type": "string", "format": "date"},
    "unit": {"const": "log-time pp"},
    "direction": {"const": "lower"},
    "publicationStatus": {"const": "candidate"},
    "modelValidation": {"enum": ["not_promoted", "validated"]},
    "identifiability": {
      "type": "object",
      "required": ["parameterColumns", "constrainedDimensions", "unpenalisedDesignRank", "unidentifiedDirections", "independentGPs", "status"],
      "properties": {
        "unidentifiedDirections": {"type": "integer", "minimum": 0},
        "status": {"enum": ["identified_under_stated_model", "not_identifiable"]}
      }
    },
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "canonicalId", "driverId", "constructorId", "scores"],
        "properties": {
          "scores": {
            "type": "object", "required": ["power", "driver", "car"],
            "additionalProperties": false,
            "properties": {"power": {"$ref": "#/$defs/component"}, "driver": {"$ref": "#/$defs/component"}, "car": {"$ref": "#/$defs/component"}}
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "required": ["value", "rank", "status", "reason", "eligibleGPs", "interval", "identifiedBootstrapFraction", "maximumPriorShiftPP"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "rank": {"type": ["integer", "null"], "minimum": 1},
        "status": {"enum": ["supported_research_estimate", "withheld"]},
        "reason": {"type": ["string", "null"]},
        "eligibleGPs": {"type": "integer", "minimum": 0},
        "interval": {"type": ["array", "null"], "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "identifiedBootstrapFraction": {"type": "number", "minimum": 0, "maximum": 1},
        "maximumPriorShiftPP": {"type": ["number", "null"], "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "withheld"}}},
          "then": {"properties": {"value": {"type": "null"}, "rank": {"type": "null"}, "interval": {"type": "null"}, "reason": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"value": {"type": "number"}, "rank": {"type": "integer", "minimum": 1}, "reason": {"type": "null"}, "interval": {"type": "array"}, "eligibleGPs": {"minimum": 5}, "identifiedBootstrapFraction": {"minimum": 0.95}, "maximumPriorShiftPP": {"type": "number", "maximum": 0.5}}}
        }
      ]
    }
  }
}
